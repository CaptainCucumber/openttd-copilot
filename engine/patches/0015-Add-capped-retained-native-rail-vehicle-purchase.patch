 src/copilot_cmd.cpp             | 61 +++++++++++++++++++++++++++++++++
 src/copilot_cmd.h               | 17 +++++++--
 src/network/network_admin.cpp   | 35 +++++++++++++------
 src/network/network_command.cpp |  3 +-
 src/saveload/copilot_sl.cpp     | 19 +++++++---
 6 files changed, 118 insertions(+), 18 deletions(-)

