+uint32_t CopilotCurrentFrame()
+{
+	/* Preserve protocol-v3 Admin frames; local single-player uses the saved game tick. */
+	return _networking ? _frame_counter : static_cast<uint32_t>(TimerGameTick::counter);
+}
