@@ -1074,6 +1075,7 @@ static uint DeliverGoodsToIndustry(const Station *st, CargoType cargo_type, uint
 
 		/* Update the cargo monitor. */
 		AddCargoDelivery(cargo_type, company, amount, {source, SourceType::Industry}, st, ind->index);
